generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── User ─────────────────────────────────────────────────────────────────────
// id = clerkId من التطبيق الأم
model User {
  id        String   @id // Clerk User ID (e.g. user_2abc123xyz)
  createdAt DateTime @default(now())

  conversations Conversation[]
  dailyLimits   DailyLimit[]
}

// ─── Conversation ─────────────────────────────────────────────────────────────
model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("محادثة جديدة")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

// ─── Message ──────────────────────────────────────────────────────────────────
model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // 'user' | 'ai'
  text           String
  category       String?  // 'football' | 'nutrition' | 'training' | 'recovery'
  imageUrl       String?
  modelUsed      String?
  fromCache      Boolean  @default(false)
  responseTimeMs Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ─── DailyLimit ───────────────────────────────────────────────────────────────
model DailyLimit {
  id     String @id @default(cuid())
  userId String
  date   String // "2025-04-26"
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ─── QACache ──────────────────────────────────────────────────────────────────
model QACache {
  id        String                       @id @default(cuid())
  question  String                       @unique
  answer    String                       @db.Text
  embedding Unsupported("vector(3072)")?
  category  String?
  language  String                       @default("ar")
  hitCount  Int                          @default(0)
  lastHit   DateTime                     @updatedAt
  createdAt DateTime                     @default(now())

  @@index([category])
  @@index([hitCount])
}

// ─── Analytics ────────────────────────────────────────────────────────────────
model Analytics {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  fromCache Boolean  @default(false)
  modelUsed String?
  responseMs Int?
  category  String?
  costSaved Float    @default(0)

  @@index([date])
}
